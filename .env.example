# Follow Up Boss API credentials (see README for how to get these).
# Never commit the real .env file - only this .env.example with blank values.

FUB_API_KEY=
FUB_SYSTEM=
FUB_SYSTEM_KEY=

# Port the server listens on (Railway sets this automatically - don't set it there).
PORT=3000

# Optional: comma-separated list of bearer tokens required to call this MCP server.
# Leave blank for local development.
MCP_AUTH_TOKENS=

# Twilio - used by the Speed to Lead automation to text new leads instantly.
# Leave blank to skip texting (the FUB event + note still run).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: override the instant-text template. {firstName} is replaced.
SPEED_TO_LEAD_SMS_TEMPLATE=

# Optional: shared secret required to call POST /webhooks/speed-to-lead.
# Leave blank for local dev; set a long random value before exposing this publicly.
SPEED_TO_LEAD_WEBHOOK_SECRET=
