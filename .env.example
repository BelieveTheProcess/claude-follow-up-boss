# Follow Up Boss API credentials (see README for how to get these).
# Never commit the real .env file - only this .env.example with blank values.

FUB_API_KEY=
FUB_SYSTEM=
FUB_SYSTEM_KEY=

# Port the server listens on (Railway sets this automatically - don't set it there).
PORT=3000

# Required once deployed anywhere reachable over the internet (leave blank only
# for local-only development). Comma-separated list of bearer tokens accepted
# on the /mcp endpoint. This is the real, static, redeploy-proof secret -
# generate one with `node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`.
MCP_AUTH_TOKENS=

# Password for the /authorize login page in src/oauth.js. Required if you'll
# connect via a client (e.g. Claude's custom-connector UI) that insists on an
# OAuth handshake rather than accepting MCP_AUTH_TOKENS as a plain bearer
# token - see "How auth works" in the README. Can be the same value as
# MCP_AUTH_TOKENS or different; it only gates the login page itself.
OAUTH_PASSWORD=

# Twilio credentials, required for the send_text tool (actually delivers an SMS -
# FUB's own /textMessages endpoint only logs messages, it doesn't send them).
# Get these from the Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Real Geeks partner credentials, required for the sync_lead_to_realgeeks tool.
# These are NOT self-generated - Real Geeks issues a username/password to your
# integration when you register at https://developers.realgeeks.com, and the
# site owner then grants your integration access to their site, which produces
# the Site UUID below.
REALGEEKS_USERNAME=
REALGEEKS_PASSWORD=
REALGEEKS_SITE_UUID=

# Slack Incoming Webhooks, required for the notify_slack tool. JSON object
# mapping a channel label you choose to that channel's webhook URL. See
# skills/slack-review-queue/SKILL.md for how to create these in Slack.
# Example: SLACK_WEBHOOKS={"marketing-review":"https://hooks.slack.com/services/..."}
SLACK_WEBHOOKS=

# Speed-to-lead (see skills/speed-to-lead/SKILL.md). No new secret needed for
# webhook signature verification - it reuses FUB_SYSTEM_KEY above.

# Which SLACK_WEBHOOKS label to alert on new leads. Defaults to "speed-to-lead".
SPEED_TO_LEAD_SLACK_CHANNEL=speed-to-lead

# Off by default on purpose - read the compliance note in
# skills/speed-to-lead/SKILL.md before setting this to "true".
AUTO_FIRST_TOUCH_SMS=false
FIRST_TOUCH_SMS_TEMPLATE=
AGENT_NAME=

# Gmail/Google Workspace SMTP, required for the send_email tool. GMAIL_USER
# is the sending address; GMAIL_APP_PASSWORD is a 16-character App Password
# (NOT your regular account password) - requires 2-Step Verification to be
# enabled on the account first, then generate one at
# https://myaccount.google.com/apppasswords. Workspace admins may need to
# explicitly allow App Passwords org-wide (Admin Console -> Security ->
# Authentication -> 2-step verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display name, e.g. "Jane Smith" -> emails send as "Jane Smith" <GMAIL_USER>.
EMAIL_FROM_NAME=

# Required for send_email's CAN-SPAM compliance footer (every commercial
# email legally needs a real physical mailing address and a working
# opt-out). Not a PO box requirement, but must be a real postal address.
AGENT_MAILING_ADDRESS=

# The public URL this server is reachable at (e.g. https://your-app.up.railway.app),
# used to build the unsubscribe link in every email's footer. No trailing slash.
PUBLIC_BASE_URL=

# Secret used to HMAC-sign unsubscribe links so they can't be forged/guessed.
# Generate one the same way as MCP_AUTH_TOKENS:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_UNSUBSCRIBE_SECRET=

# Agent/brokerage signature appended to every send_email message (above the
# CAN-SPAM footer). Every field below is optional and only prints if set -
# leave AGENT_NAME blank to send with no signature at all. Fill these in
# yourself rather than guessing from a screenshot/photo of an existing
# signature - a license number or ranking claim needs to be exact, and most
# states' real estate advertising rules require ranking/award claims to be
# accurate and current, which this file has no way to verify for you.
AGENT_NAME=
AGENT_TITLE=
AGENT_LICENSE=
BROKERAGE_NAME=
AGENT_PHONE=
AGENT_MOBILE=
AGENT_WEBSITE=
# Optional scheduling link, e.g. a Calendly URL.
AGENT_BOOKING_URL=
# Optional - must be a real, hosted image URL (not a local file path; email
# clients can't load images off this server's filesystem).
AGENT_HEADSHOT_URL=
BROKERAGE_LOGO_URL=
# Optional, printed verbatim - e.g. "Nationally Ranked Top 1% by Forbes &
# The Wall Street Journal". Only set this to a claim you can substantiate.
AGENT_RANKING_TEXT=
