# Follow Up Boss API credentials (see README for how to get these).
# Never commit the real .env file - only this .env.example with blank values.

FUB_API_KEY=
FUB_SYSTEM=
FUB_SYSTEM_KEY=

# Port the server listens on (Railway sets this automatically - don't set it there).
PORT=3000

# Required once deployed anywhere reachable over the internet (leave blank only
# for local-only development). Comma-separated list of bearer tokens accepted
# on the /mcp endpoint - the connecting MCP client sends one as
# `Authorization: Bearer <token>`. This is a static, redeploy-proof secret:
# generate one with `node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`.
MCP_AUTH_TOKENS=

# Twilio credentials, required for the send_text tool (actually delivers an SMS -
# FUB's own /textMessages endpoint only logs messages, it doesn't send them).
# Get these from the Twilio Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Real Geeks partner credentials, required for the sync_lead_to_realgeeks tool.
# These are NOT self-generated - Real Geeks issues a username/password to your
# integration when you register at https://developers.realgeeks.com, and the
# site owner then grants your integration access to their site, which produces
# the Site UUID below.
REALGEEKS_USERNAME=
REALGEEKS_PASSWORD=
REALGEEKS_SITE_UUID=

# Slack Incoming Webhooks, required for the notify_slack tool. JSON object
# mapping a channel label you choose to that channel's webhook URL. See
# skills/slack-review-queue/SKILL.md for how to create these in Slack.
# Example: SLACK_WEBHOOKS={"marketing-review":"https://hooks.slack.com/services/..."}
SLACK_WEBHOOKS=

# Speed-to-lead (see skills/speed-to-lead/SKILL.md). No new secret needed for
# webhook signature verification - it reuses FUB_SYSTEM_KEY above.

# Which SLACK_WEBHOOKS label to alert on new leads. Defaults to "speed-to-lead".
SPEED_TO_LEAD_SLACK_CHANNEL=speed-to-lead

# Off by default on purpose - read the compliance note in
# skills/speed-to-lead/SKILL.md before setting this to "true".
AUTO_FIRST_TOUCH_SMS=false
FIRST_TOUCH_SMS_TEMPLATE=
AGENT_NAME=
