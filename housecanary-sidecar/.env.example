# HouseCanary API credentials - the same ones used for the Analytics API,
# no separate signup for MCP access. Basic Auth against HouseCanary's API.
HOUSECANARY_API_USERNAME=
HOUSECANARY_API_PASSWORD=

# Comma-separated bearer tokens this proxy accepts on /mcp. housecanary-mcp
# itself has no auth of its own (see proxy.py) - this is the only thing
# standing between a public Railway URL and unrestricted, billable access
# to every HouseCanary tool. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Can reuse the main FUB server's MCP_AUTH_TOKENS value or be a separate one.
MCP_AUTH_TOKENS=

# Port this proxy listens on publicly (Railway sets this automatically -
# don't set it there). housecanary-mcp itself always runs on loopback only,
# on the separate internal port hardcoded in proxy.py.
PORT=8080
